# Python virtual environment
.venv/
venv/

# Environment variables / secrets
.env
.env.*
.env.example

# Python cache / compiled files
__pycache__/
*.py[cod]
*$py.class

# Test / tooling cache
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local database files
*.db
*.sqlite
*.sqlite3

# Raw imported licensing data
data/imports/*
!data/imports/.gitkeep

# Generated reports
data/reports/*
!data/reports/.gitkeep

# Logs
*.log
logs/

# IDE / editor files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
~$*